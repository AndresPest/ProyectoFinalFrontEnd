rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leer y escribir en la colección 'usuario' si el usuario está autenticado
    match /usuario/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Regla general para el resto de la base de datos (cuestionarios, etc.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}